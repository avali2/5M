# ==================================================
# VALIDO 1M PRO — Variables de Entorno
# ==================================================
# Copia este archivo a .env y completa los valores

# --- SERVER ---
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# --- RENDER / URL ---
# VITE_API_BASE_URL = La URL de tu app en Render
# Ejemplo: https://valido-1m.onrender.com
# (Render la asigna automáticamente, puedes dejarla vacía)
VITE_API_BASE_URL=
PUBLIC_BASE_URL=
APP_BASE_URL=

# --- GEMINI GUARDIAN (OBLIGATORIO) ---
# ¿Dónde obtenerla?
# 1. Ve a https://aistudio.google.com/apikey
# 2. Inicia sesión con tu cuenta de Google
# 3. Haz clic en "Create API Key"
# 4. Copia la key aquí
# ES GRATIS — tiene cuota gratuita generosa
VITE_GEMINI_API_KEY=

# --- TRADIER (OBLIGATORIO para datos reales) ---
# ¿Dónde obtenerla?
# 1. Regístrate en https://tradier.com
# 2. Ve a https://brokerage.tradier.com/settings/api
# 3. Copia tu Access Token
# 4. El plan básico es suficiente ($0/mes)
TRADIER_TOKEN=
TRADIER_ACCESS_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1

# --- POLYGON.IO (OPCIONAL — para Tape Reading real) ---
# ¿Dónde obtenerla?
# 1. Ve a https://polygon.io
# 2. Regístrate (plan Developer: gratis, 5 calls/min)
# 3. Ve a Dashboard → API Keys
# 4. Copia tu key aquí
# Sin esto, el Tape Reading usa proxy OHLCV
POLYGON_API_KEY=

# --- SEGURIDAD ---
SESSION_SECRET=pon_una_clave_segura_aqui
APP_ACCESS_KEY=pon_una_clave_de_acceso_aqui
REQUIRE_ACCESS_KEY=true

# --- OTROS ---
VALIDO_BUILD_VERSION=3.0.0
MARKET_DATA_MODE=live
ENABLE_YAHOO_PROVIDER=true