# Production runtime. Do not commit a real .env file.
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
PUBLIC_BASE_URL=
VITE_API_BASE_URL=
CLIENT_ORIGIN=
VALIDO_BUILD_VERSION=
VALIDO_BUILD_TIMESTAMP=
APP_ENV=production
SESSION_SECRET=

# Required for public deployment. Use a long private password stored only in hosting secrets.
APP_ACCESS_KEY=
REQUIRE_ACCESS_KEY=true

# Essential options/quotes source. Tradier includes option Greeks and IV when greeks=true.
TRADIER_TOKEN=
TRADIER_ACCESS_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_ACCOUNT_ID=
TRADIER_SANDBOX=false

# Supplemental or alternative option snapshot source for IV, Greeks and OI.
POLYGON_API_KEY=

# Free delayed fallback for quotes, daily history, option chains and news.
# Disable only if you want the scanner to fail closed when Tradier/Polygon are absent.
ENABLE_YAHOO_PROVIDER=true

# Macro calendar, earnings, news and insider transactions.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# Licensed unusual options activity feed.
BENZINGA_API_KEY=

# AI tutor providers. Gemini is preferred for manual explanations; all math stays deterministic.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_PRIMARY_PROVIDER=gemini
AI_AUTO_TUTOR=true
AI_AUTO_SIGNAL_DECISION=false
AI_AUTO_NARRATIVE=false
AI_MANUAL_EXPLAIN=true
AI_DAILY_TOKEN_BUDGET=30000
AI_DAILY_REQUEST_BUDGET=8
AI_MAX_INPUT_TOKENS_PER_CALL=2200
AI_MAX_OUTPUT_TOKENS_PER_CALL=650
AI_MAX_TOTAL_TOKENS_PER_CALL=3000
AI_MIN_AUTOMATIC_CALL_INTERVAL_MINUTES=60
AI_COOLDOWN_AFTER_429_MINUTES=120
AI_DISABLE_AUTO_AT_USAGE_PERCENT=75
AI_DISABLE_ALL_AT_USAGE_PERCENT=95
AI_FALLBACK_TO_DETERMINISTIC=true

# Optional OpenAI narrative, manual only. It never calculates trades or blocks scanner.
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MANUAL_ONLY=true
# Backward-compatible flag. Keep false unless you intentionally enable manual OpenAI.
ENABLE_AI_ASSISTANT=false
AI_DAILY_CALL_LIMIT=10

# Options Guardian is deterministic and enabled without AI. Web Push is optional and free to configure.
GUARDIAN_ENABLED=true
PUSH_ENABLED=true
ENABLE_WEB_PUSH=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@example.com
PUSH_MAX_DAILY_SIGNALS=5
PUSH_SYMBOL_COOLDOWN_MINUTES=30
# Reserved optional transport. FCM is not required by Guardian Web Push.
ENABLE_FCM=false
FCM_SERVER_KEY=

# Labels the configured feed context shown in the UI: live, delayed, manual or mock.
MARKET_DATA_MODE=live

# Production persistence. When unset, Valido 1M keeps local fallback data files.
DATABASE_URL=
DATABASE_SSL=false
SNAPSHOT_INTERVAL_MINUTES=60
MAX_SNAPSHOT_CONTRACTS=80
SNAPSHOT_RETENTION_DAYS=45

ACCOUNT_SIZE=2000
RISK_PER_TRADE_PCT=2
MAX_COLLATERAL_PCT=20
MAX_DAILY_LOSS_PCT=5
MAX_WEEKLY_LOSS_PCT=8
MAX_OPEN_TRADES=3
DEFAULT_RISK_MODE=MODERATE_AGGRESSIVE
MIN_POP_CREDIT_SPREAD=0.70
MAX_DAILY_SIGNALS=5
MAX_RISK_PER_TRADE_PCT=0.02
MAX_PORTFOLIO_RISK_PCT=0.06
MIN_SCORE=75
MIN_DTE=21
MAX_DTE=45
ALLOW_1DTE_APPROVAL=false
ALLOW_0DTE=false
ALLOW_EARNINGS=false
ALLOW_MARGIN=false
AUTO_REFRESH_SECONDS=60
IV_RANK_MIN_OBSERVATIONS=30
SCANNER_ENABLED=true
SCANNER_CORE_INTERVAL_MINUTES=5
SCANNER_STOCK_INTERVAL_MINUTES=10
SCANNER_AFTER_HOURS_INTERVAL_MINUTES=45
APP_BASE_URL=https://TU_APP_RENDER.onrender.com
