NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Keep the app protected in production. The browser sends this value as X-5M-Key.
APP_ACCESS_KEY=
REQUIRE_ACCESS_KEY=false
CLIENT_ORIGIN=http://127.0.0.1:5173

# Tradier read-only market data
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_SANDBOX=false

# Gemini evaluation; the server never exposes this key to the browser.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUIRED=true

# Signal policy
WATCHLIST_CORE=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,SPY,QQQ,IWM,DIA
MAGNIFICENT_7=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
MIN_DTE=21
MAX_DTE=45
ACCOUNT_SIZE=2000
RISK_PER_TRADE_PCT=1
MAX_CONTRACTS=3
MIN_POP=0.60
MIN_SCORE=70
MIN_CREDIT=0.10
MAX_DAILY_SIGNALS=3
SCAN_INTERVAL_MINUTES=5
MARKET_OPEN_ONLY=true
BLOCK_0DTE=true
BLOCK_EARNINGS_UNKNOWN=false

# Web Push. Generate once with: npx web-push generate-vapid-keys
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Local fallback store. Use a persistent disk or DATABASE_URL for durable subscriptions on Render.
DATA_DIR=./data
