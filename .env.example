NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# El navegador envía esta clave en X-5M-Key; no la publiques en código.
APP_ACCESS_KEY=
REQUIRE_ACCESS_KEY=false
CLIENT_ORIGIN=http://127.0.0.1:5173
# Origen del panel estático de señales publicado en Sites.
SITE_ORIGIN=https://five-millions-signals.jobvalido.chatgpt.site
PUBLIC_BASE_URL=

# Datos de mercado. El modo real usa esta misma credencial de producción.
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_SANDBOX=false
# Debe coincidir con el entitlement real de la cuenta; timestamps recientes también son obligatorios.
TRADIER_REALTIME_ENTITLED=false

# Gemini y Google Search grounding; ambas claves permanecen en el servidor.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUIRED=true
NEWS_CACHE_MINUTES=5
NEWS_MIN_SOURCES=3
NEWS_MAX_CLEAR_RISK=35

# Señales: solo Cash-Secured Puts y Covered Calls.
PRIORITY_SYMBOLS=AMD,MSFT,SPY
INDEX_PROXIES=SPY,QQQ,IWM,DIA
CONTEXT_INDICES=SPX,NDX,RUT,VIX
MAGNIFICENT_7=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
OPTIONS_LEADERS=AMD,AVGO,PLTR,NFLX,HOOD,MU,ORCL,TSM,BABA,BAC,COIN
SECTOR_MACRO_ETFS=SMH,XLK,XLF,XLE,TLT,IBIT
WHEEL_SYMBOLS=SOFI,MARA
WATCHLIST_CORE=AMD,MSFT,SPY,QQQ,IWM,DIA,SOFI,MARA,AAPL,NVDA,AMZN,META,GOOGL,TSLA,AVGO,PLTR,NFLX,HOOD,MU,ORCL,TSM,BABA,BAC,COIN,SMH,XLK,XLF,XLE,TLT,IBIT
MAX_SYMBOLS_PER_SCAN=12
WATCHLIST_ROTATION_ENABLED=true
WHEEL_ENABLED=true
WHEEL_MIN_DTE=14
WHEEL_MAX_DTE=45
WHEEL_TARGET_DTE=30
WHEEL_SHORT_DELTA_MIN=0.15
WHEEL_SHORT_DELTA_MAX=0.30
WHEEL_MIN_LIQUIDITY=60
WHEEL_MIN_SCORE=65
WHEEL_TAKE_PROFIT_PCT=0.50
WHEEL_STOP_MULTIPLE=2
WHEEL_TIME_STOP_DTE=7
MIN_OPTION_VOLUME=10
MIN_OPEN_INTEREST=100
MAX_OPTION_SPREAD_PCT=0.25
MIN_CREDIT=0.10
MAX_DAILY_SIGNALS=3
MIN_TIMEFRAMES=3
MAX_DATA_AGE_MINUTES=5
PORTFOLIO_FRESH_HOURS=24
SCAN_INTERVAL_MINUTES=5
MANUAL_SCAN_COOLDOWN_SECONDS=60
MARKET_OPEN_ONLY=true
SCANNER_ENABLED=true
INSTITUTIONAL_FLOW_ENABLED=true
INSTITUTIONAL_FLOW_MIN_CONFIDENCE=55
INSTITUTIONAL_FLOW_MIN_VOLUME=100
INSTITUTIONAL_FLOW_MIN_VOLUME_OI=0.5

# Web Push. Generate once with: npx web-push generate-vapid-keys
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SQLite persistente; en Render se monta en /var/data.
DATA_DIR=./data
LEARNING_ENABLED=true
LEARNING_MIN_VALIDATED_SAMPLES=20
LEARNING_HISTORY_LIMIT=500
LEARNING_SIGNAL_RETENTION=5000

# Motor autónomo. off | shadow | paper | live
BOT_MODE=shadow
# aggressive: 14–35 DTE, delta 0.22–0.38. standard conserva 21–45 DTE, delta 0.15–0.32.
BOT_PROFILE=aggressive
# Activado por defecto en observación y Sandbox. En real requiere true.
BOT_IRON_CONDOR=
# Presupuesto explícito en USD para real. También rige el tope de 1% de equity.
BOT_MAX_RISK_USD=
BOT_ACCOUNT_ID=
BOT_SANDBOX_ACCOUNT_ID=
TRADIER_SANDBOX_TOKEN=
# Para real, DATA_DIR debe ser una ruta absoluta en almacenamiento persistente.
BOT_DURABLE_STORAGE=false
# En Render, especifica el punto de montaje del disco que contiene DATA_DIR.
BOT_PERSISTENT_MOUNT=
# ===================== MEJORA DSH: NiTo CALL/PUT + spreads agresivos =====================
# Mercado simulado: se activa solo si no hay TRADIER_TOKEN. Poné false para exigir datos reales.
DEMO_MODE=
# Datos reales sin clave (StockAnalysis + OPC + Yahoo intradía). Se usa si falta TRADIER_TOKEN.
FREE_DATA=true
# Tasa libre de riesgo usada en Black-Scholes (0.043 = 4,3%).
OPTIONS_RATE=0.043

# DeepSeek (opcional, se usa si AI_PROVIDER=deepseek o auto con clave presente).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_TOKENS=1600
DEEPSEEK_TEMPERATURE=0.4

# Analista IA: auto | deepseek | gemini
AI_PROVIDER=auto
AI_CACHE_MINUTES=10
AI_MAX_TOKENS=1400
AI_TEMPERATURE=0.35
AI_LANGUAGE=es

# NiTo direccional (CALL/PUT)
NITO_SYMBOLS=AMD,SPY,QQQ,NVDA,MSFT,TSLA,AAPL,META,AMZN,GOOGL,PLTR,IWM
NITO_DTE_MIN=7
NITO_DTE_MAX=35
NITO_DELTA_MIN=0.33
NITO_DELTA_MAX=0.72
NITO_MAX_SIGNALS=3
NITO_MIN_OI=100
NITO_MIN_VOLUME=10
NITO_MAX_SPREAD_PCT=0.18
NITO_RISK_PCT=1.5
NITO_TIME_STOP_DAYS=5

# Spreads agresivos: standard | aggressive | max
SPREAD_PROFILE=aggressive
SPREAD_MAX_IDEAS=3
SPREAD_MIN_CREDIT=0.15
COMMISSION_PER_CONTRACT=0.65