NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Keep the app protected in production. The browser sends this value as X-5M-Key.
APP_ACCESS_KEY=
REQUIRE_ACCESS_KEY=false
CLIENT_ORIGIN=http://127.0.0.1:5173
# Set both URLs to the final HTTPS domain after the host generates it.
PUBLIC_BASE_URL=

# Tradier read-only market data
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_SANDBOX=false
# Set true only when this production token is entitled to Tradier real-time data.
# READY signals remain blocked while this is false.
TRADIER_REALTIME_ENTITLED=false

# Gemini evaluation; the server never exposes this key to the browser.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUIRED=true
NEWS_CACHE_MINUTES=15
NEWS_MIN_SOURCES=3
NEWS_MAX_CLEAR_RISK=35

# Signal policy
PRIORITY_SYMBOLS=AMD,MSFT,SPY
INDEX_PROXIES=SPY,QQQ,IWM,DIA
CONTEXT_INDICES=SPX,NDX,RUT,VIX
MAGNIFICENT_7=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
OPTIONS_LEADERS=AMD,AVGO,PLTR,NFLX,HOOD,MU,ORCL,TSM,BABA,BAC,COIN
SECTOR_MACRO_ETFS=SMH,XLK,XLF,XLE,TLT,IBIT
WATCHLIST_CORE=AMD,MSFT,SPY,QQQ,IWM,DIA,AAPL,NVDA,AMZN,META,GOOGL,TSLA,AVGO,PLTR,NFLX,HOOD,MU,ORCL,TSM,BABA,BAC,COIN,SMH,XLK,XLF,XLE,TLT,IBIT
MAX_SYMBOLS_PER_SCAN=12
WATCHLIST_ROTATION_ENABLED=true
MIN_DTE=21
MAX_DTE=45
TARGET_DTE=30
CORE_SHORT_DELTA_MIN=0.12
CORE_SHORT_DELTA_MAX=0.30
CORE_MIN_LIQUIDITY=40
CORE_TAKE_PROFIT_PCT=0.50
CORE_STOP_MULTIPLE=2
CORE_TIME_STOP_DTE=21
AGGRESSIVE_ENABLED=true
AGGRESSIVE_PRIORITY_ONLY=false
AGGRESSIVE_MIN_DTE=7
AGGRESSIVE_MAX_DTE=20
AGGRESSIVE_TARGET_DTE=14
AGGRESSIVE_SHORT_DELTA_MIN=0.24
AGGRESSIVE_SHORT_DELTA_MAX=0.40
AGGRESSIVE_MIN_LIQUIDITY=50
AGGRESSIVE_MIN_SCORE=76
AGGRESSIVE_MIN_POP=0.58
AGGRESSIVE_TAKE_PROFIT_PCT=0.35
AGGRESSIVE_STOP_MULTIPLE=1.75
AGGRESSIVE_TIME_STOP_DTE=7
AGGRESSIVE_RISK_MULTIPLIER=1
AGGRESSIVE_MAX_CONTRACTS=999
# Legacy sizing values are informational only; signals are never blocked by balance or contract count.
ACCOUNT_SIZE=0
RISK_PER_TRADE_PCT=1
MAX_CONTRACTS=999
MAXIMUM_SPREAD_WIDTH=25
MIN_POP=0.60
MIN_SCORE=70
MIN_CREDIT=0.10
MAX_DAILY_SIGNALS=3
SCAN_INTERVAL_MINUTES=5
MANUAL_SCAN_COOLDOWN_SECONDS=60
MARKET_OPEN_ONLY=true
SCANNER_ENABLED=true
BLOCK_0DTE=true
REQUIRE_AFFORDABLE_SIGNAL=false
INSTITUTIONAL_FLOW_ENABLED=true
INSTITUTIONAL_FLOW_REQUIRED_FOR_AGGRESSIVE=true
INSTITUTIONAL_FLOW_MIN_CONFIDENCE=55
INSTITUTIONAL_FLOW_MIN_VOLUME=100
INSTITUTIONAL_FLOW_MIN_VOLUME_OI=0.5
MIN_TIMEFRAMES=3
MAX_DATA_AGE_MINUTES=20

# Web Push. Generate once with: npx web-push generate-vapid-keys
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Persistent SQLite database. Mount a durable volume at /app/data in production.
DATA_DIR=./data
LEARNING_ENABLED=true
LEARNING_MIN_VALIDATED_SAMPLES=20
LEARNING_HISTORY_LIMIT=500
LEARNING_SIGNAL_RETENTION=5000
