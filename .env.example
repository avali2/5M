NODE_ENV=production
APP_ENV=production
PORT=10000
HOST=0.0.0.0
PUBLIC_BASE_URL=
APP_BASE_URL=
CLIENT_ORIGIN=
VITE_API_BASE_URL=
VALIDO_BUILD_VERSION=
VALIDO_BUILD_TIMESTAMP=
SESSION_SECRET=

# Security / private dashboard access
APP_ACCESS_KEY=
REQUIRE_ACCESS_KEY=true

# Market data
TRADIER_ACCESS_TOKEN=
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_ACCOUNT_ID=
TRADIER_SANDBOX=false
ENABLE_YAHOO_PROVIDER=true
MARKET_DATA_MODE=live

# Optional / important data providers
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
BENZINGA_API_KEY=

# Gemini / OpenAI: explanation only, never trade math
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_PRIMARY_PROVIDER=gemini
AI_AUTO_TUTOR=true
AI_AUTO_SIGNAL_DECISION=true
AI_AUTO_NARRATIVE=false
AI_MANUAL_EXPLAIN=true
AI_DAILY_TOKEN_BUDGET=90000
AI_DAILY_REQUEST_BUDGET=28
AI_MAX_INPUT_TOKENS_PER_CALL=2200
AI_MAX_OUTPUT_TOKENS_PER_CALL=800
AI_MAX_TOTAL_TOKENS_PER_CALL=3000
AI_MIN_AUTOMATIC_CALL_INTERVAL_MINUTES=10
AI_COOLDOWN_AFTER_429_MINUTES=120
AI_DISABLE_AUTO_AT_USAGE_PERCENT=90
AI_DISABLE_ALL_AT_USAGE_PERCENT=97
AI_FALLBACK_TO_DETERMINISTIC=true

ENABLE_OPENAI=false
OPENAI_MANUAL_ONLY=true
OPENAI_API_KEY=
OPENAI_MODEL=
ENABLE_AI_ASSISTANT=false
AI_DAILY_CALL_LIMIT=10
FAIL_CLOSED_ON_AI_ERROR=false
FAIL_CLOSED_ON_OPENAI_ERROR=false
FAIL_CLOSED_ON_GEMINI_ERROR=false

# Agent / Gemini Guardian
GUARDIAN_ENABLED=true
AGENT_ENABLED=true
AGENT_NAME=Gemini Guardian
AGENT_MODE=gatekeeper
AGENT_REFRESH_INTERVAL_MINUTES=5
AGENT_MANUAL_SCAN_ENABLED=true
AGENT_AUTO_VERIFY_SIGNALS=true
AGENT_VERIFY_MIN_SCORE=78
AGENT_CREDIT_REVIEW_MIN_SCORE=60
AGENT_REVIEW_TOP_N=8
AGENT_CACHE_TTL_MINUTES=180
AGENT_MAX_AI_VERIFICATIONS_PER_DAY=24
AGENT_MINUTES_BETWEEN_AI_CALLS=10
AGENT_DISABLE_AI_AT_USAGE_PERCENT=90
AGENT_FAILSAFE_DETERMINISTIC=true
AGENT_REQUIRE_STRUCTURED_JSON=true

# Real signal filtering
REAL_SIGNALS_ONLY=true
SIGNAL_MIN_SCORE=82
SIGNAL_MIN_POP=0.70
SIGNAL_REQUIRE_RISK_APPROVAL=true
SIGNAL_REQUIRE_MACRO_CLEARANCE=true
SIGNAL_REQUIRE_NEWS_CLEARANCE=true
SIGNAL_REQUIRE_AI_CONFIRMATION=true
SIGNAL_MAX_PER_DAY=3
SIGNAL_MIN_TARGET_PROFIT=30

# Macro / News / Fed / Geopolitical Guardian
MACRO_GUARD_ENABLED=true
NEWS_GUARD_ENABLED=true
GEOPOLITICAL_GUARD_ENABLED=true
FED_GUARD_ENABLED=true
EARNINGS_GUARD_ENABLED=true
HIGH_IMPACT_EVENT_BLACKOUT_HOURS=24
MEDIUM_IMPACT_EVENT_CAUTION_HOURS=8
NEWS_LOOKBACK_HOURS=24
NEWS_CAUTION_SCORE=65
NEWS_BLOCK_SCORE=80
FED_EVENT_CAUTION_HOURS=48
WAR_NEWS_BLOCK_ENABLED=true
ALLOW_UNVERIFIED_MACRO_WHEN_FEEDS_MISSING=false
ALLOW_UNVERIFIED_NEWS_WHEN_FEEDS_MISSING=false
FAIL_CLOSED_ON_MACRO_48H=false
FAIL_CLOSED_ON_IV_RANK_BUILDING=false
FAIL_CLOSED_ON_NEWS_REVIEW=false
FAIL_CLOSED_ON_MACRO_OVERLAY=false

# UI behavior
AUTO_REFRESH_SECONDS=300
SHOW_MANUAL_REFRESH_BUTTON=true
SHOW_AGENT_PANEL=true
SHOW_UNAVAILABLE_FEEDS_AS_OPTIONAL=true
HIDE_PREMIUM_FEEDS_IF_UNCONFIGURED=true
HIDE_REJECTED_SIGNALS_BY_DEFAULT=true
